import hre from "hardhat";

const SCHEDULER =
  "0x56e776BAE2DD60664b69Bd5F865F1180ffB7D58B";

const TEE_SERVICE_REGISTRY =
  "0x9644e8562cE0Fe12b4deeC4163c064A8862Bf47F";

describe("RitualPredict", function () {
  async function deploy() {
    const { viem } = await hre.network.getOrCreate();

    const client = await viem.getPublicClient();

    // Deploy MockScheduler and install its runtime bytecode
    // at Ritual's canonical Scheduler address.
    const mockScheduler =
      await viem.deployContract("MockScheduler");

    const schedulerCode = await client.getCode({
      address: mockScheduler.address,
    });

    if (!schedulerCode) {
      throw new Error("Mock Scheduler has no runtime bytecode");
    }

    await client.request({
      method: "hardhat_setCode" as never,
      params: [
        SCHEDULER,
        schedulerCode,
      ] as never,
    });

    // MockScheduler.nextCallId is slot 0.
    await client.request({
      method: "hardhat_setStorageAt" as never,
      params: [
        SCHEDULER,
        "0x" + "00".repeat(32),
        "0x" +
          "00".repeat(31) +
          "01",
      ] as never,
    });

    // Deploy MockTEERegistry and install it at the
    // canonical TEE Service Registry address.
    const mockRegistry =
      await viem.deployContract("MockTEERegistry");

    const registryCode = await client.getCode({
      address: mockRegistry.address,
    });

    if (!registryCode) {
      throw new Error(
        "Mock TEE Registry has no runtime bytecode",
      );
    }

    await client.request({
      method: "hardhat_setCode" as never,
      params: [
        TEE_SERVICE_REGISTRY,
        registryCode,
      ] as never,
    });

    const [owner, alice, bob] =
      await viem.getWalletClients();

    const factory =
      await viem.deployContract(
        "RitualPredict",
        [195n],
      );

    return {
      viem,
      client,
      factory,
      owner,
      alice,
      bob,
    };
  }

  const market = {
    question: "Will ETH be above $3000?",
    oracleUrl:
      "https://example.com/price.json",
    jsonPath: ".price",
    target: 3000n,
    comparator: 0,
    bettingSeconds: 60n,
    resolveDelaySeconds: 30n,
  };

  async function expectRejected(
    fn: () => Promise<unknown>,
  ) {
    await assert.rejects(fn);
  }

  async function mineBlocks(
    client: any,
    blocks: bigint,
  ) {
    if (blocks <= 0n) return;

    await client.request({
      method: "hardhat_mine" as never,
      params: [
        "0x" + blocks.toString(16),
      ] as never,
    });
  }

  async function execute(
    scheduler: any,
    client: any,
    callId: bigint,
    executionIndex: bigint,
  ) {
    const hash =
      await scheduler.write.execute([
        callId,
        executionIndex,
      ]);

    await client.waitForTransactionReceipt({
      hash,
    });

    return hash;
  }


  async function installOracleMocks(
    viem: any,
    client: any,
  ) {
    const mockHttp =
      await viem.deployContract("MockHTTP");

    const httpCode = await client.getCode({
      address: mockHttp.address,
    });

    if (!httpCode) {
      throw new Error("Mock HTTP has no runtime bytecode");
    }

    await client.request({
      method: "hardhat_setCode" as never,
      params: [
        "0x0000000000000000000000000000000000000801",
        httpCode,
      ] as never,
    });

    const mockJq =
      await viem.deployContract("MockJQ");

    const jqCode = await client.getCode({
      address: mockJq.address,
    });

    if (!jqCode) {
      throw new Error("Mock JQ has no runtime bytecode");
    }

    await client.request({
      method: "hardhat_setCode" as never,
      params: [
        "0x0000000000000000000000000000000000000803",
        jqCode,
      ] as never,
    });
  }

  it("deploys with a valid block time", async function () {
    const { factory } = await deploy();

    assert.equal(
      await factory.read.blockTimeMs(),
      195n,
    );
  });

  it("rejects zero block time", async function () {
    const { viem } =
      await hre.network.getOrCreate();

    await expectRejected(async () => {
      await viem.deployContract(
        "RitualPredict",
        [0n],
      );
    });
  });

  it("rejects an empty question", async function () {
    const { factory } = await deploy();

    await expectRejected(() =>
      factory.write.createMarket([
        {
          ...market,
          question: "",
        },
      ]),
    );
  });

  it("rejects an empty oracle URL", async function () {
    const { factory } = await deploy();

    await expectRejected(() =>
      factory.write.createMarket([
        {
          ...market,
          oracleUrl: "",
        },
      ]),
    );
  });

  it("rejects an empty JSON path", async function () {
    const { factory } = await deploy();

    await expectRejected(() =>
      factory.write.createMarket([
        {
          ...market,
          jsonPath: "",
        },
      ]),
    );
  });

  it("rejects betting duration below minimum", async function () {
    const { factory } = await deploy();

    await expectRejected(() =>
      factory.write.createMarket([
        {
          ...market,
          bettingSeconds: 29n,
        },
      ]),
    );
  });

  it("rejects resolution delay below minimum", async function () {
    const { factory } = await deploy();

    await expectRejected(() =>
      factory.write.createMarket([
        {
          ...market,
          resolveDelaySeconds: 14n,
        },
      ]),
    );
  });

  it("creates a market and records its resolution rule", async function () {
    const { factory } = await deploy();

    await factory.write.createMarket([
      market,
    ]);

    const created =
      await factory.read.getMarket([1n]);

    assert.equal(created.id, 1n);
    assert.equal(
      created.question,
      market.question,
    );
    assert.equal(
      created.oracleUrl,
      market.oracleUrl,
    );
    assert.equal(
      created.jsonPath,
      market.jsonPath,
    );
    assert.equal(
      created.target,
      3000n,
    );
    assert.equal(
      created.comparator,
      0,
    );
    assert.equal(
      created.totalYes,
      0n,
    );
    assert.equal(
      created.totalNo,
      0n,
    );
    assert.equal(
      created.attempts,
      0,
    );
    assert.equal(
      created.outcome,
      0,
    );
  });

  it("accepts YES and NO bets", async function () {
    const {
      factory,
      alice,
      bob,
    } = await deploy();

    await factory.write.createMarket([
      market,
    ]);

    await factory.write.bet(
      [1n, true],
      {
        account: alice.account,
        value:
          1_000_000_000_000_000_000n,
      },
    );

    await factory.write.bet(
      [1n, false],
      {
        account: bob.account,
        value:
          2_000_000_000_000_000_000n,
      },
    );

    const result =
      await factory.read.getMarket([1n]);

    assert.equal(
      result.totalYes,
      1_000_000_000_000_000_000n,
    );

    assert.equal(
      result.totalNo,
      2_000_000_000_000_000_000n,
    );

    const aliceStake =
      await factory.read.stakesOf([
        1n,
        alice.account.address,
      ]);

    assert.equal(
      aliceStake[0],
      1_000_000_000_000_000_000n,
    );
  });

  it("rejects a zero-value bet", async function () {
    const { factory } = await deploy();

    await factory.write.createMarket([
      market,
    ]);

    await expectRejected(() =>
      factory.write.bet([1n, true]),
    );
  });

  it("records the Scheduler parameters when creating a market", async function () {
    const {
      factory,
      viem,
    } = await deploy();

    await factory.write.createMarket([
      market,
    ]);

    const scheduler =
      await viem.getContractAt(
        "MockScheduler",
        SCHEDULER,
      );

    const call =
      await scheduler.read.getCall([1n]);

    const created =
      await factory.read.getMarket([1n]);

    assert.equal(
      call[1],
      2_000_000,
    );

    assert.equal(
      call[3],
      3,
    );

    assert.equal(
      call[4],
      200,
    );

    assert.equal(
      call[5],
      150,
    );

    assert.equal(
      call[6],
      1_000_000_000n,
    );

    assert.equal(
      call[7],
      0n,
    );

    assert.equal(
      call[8],
      0n,
    );

    assert.equal(
      call[9].toLowerCase(),
      factory.address.toLowerCase(),
    );

    assert.equal(
      BigInt(call[2]),
      created.resolveBlock,
    );

    assert.equal(
      call[0].length,
      138,
    );
  });

  it("Scheduler callback reaches the market after betting closes", async function () {
    const {
      factory,
      viem,
    } = await deploy();

    await factory.write.createMarket([
      market,
    ]);

    const scheduler =
      await viem.getContractAt(
        "MockScheduler",
        SCHEDULER,
      );

    const client =
      await viem.getPublicClient();

    const before =
      await factory.read.getMarket([1n]);

    const currentBlock =
      await client.getBlockNumber();

    const blocksToClose =
      before.closeBlock -
      currentBlock;

    await mineBlocks(
      client,
      blocksToClose + 1n,
    );

    await execute(
      scheduler,
      client,
      1n,
      0n,
    );

    const after =
      await factory.read.getMarket([1n]);

    assert.equal(
      after.attempts,
      1,
    );

    assert.equal(
      after.state,
      2,
    );
  });

  it("records a failed oracle attempt without reverting", async function () {
    const {
      factory,
      viem,
    } = await deploy();

    await factory.write.createMarket([
      market,
    ]);

    const scheduler =
      await viem.getContractAt(
        "MockScheduler",
        SCHEDULER,
      );

    const client =
      await viem.getPublicClient();

    const before =
      await factory.read.getMarket([1n]);

    const currentBlock =
      await client.getBlockNumber();

    await mineBlocks(
      client,
      before.closeBlock -
        currentBlock +
        1n,
    );

    await execute(
      scheduler,
      client,
      1n,
      0n,
    );

    const after =
      await factory.read.getMarket([1n]);

    assert.equal(
      after.attempts,
      1,
    );

    assert.equal(
      after.state,
      2,
    );

    assert.equal(
      after.outcome,
      0,
    );
  });

  it("allows multiple scheduled attempts", async function () {
    const {
      factory,
      viem,
    } = await deploy();

    await factory.write.createMarket([
      market,
    ]);

    const scheduler =
      await viem.getContractAt(
        "MockScheduler",
        SCHEDULER,
      );

    const client =
      await viem.getPublicClient();

    const created =
      await factory.read.getMarket([1n]);

    const currentBlock =
      await client.getBlockNumber();

    await mineBlocks(
      client,
      created.closeBlock -
        currentBlock +
        1n,
    );

    await execute(
      scheduler,
      client,
      1n,
      0n,
    );

    let state =
      await factory.read.getMarket([1n]);

    assert.equal(
      state.attempts,
      1,
    );

    assert.equal(
      state.state,
      2,
    );

    await execute(
      scheduler,
      client,
      1n,
      1n,
    );

    state =
      await factory.read.getMarket([1n]);

    assert.equal(
      state.attempts,
      2,
    );

    assert.equal(
      state.state,
      2,
    );

    await execute(
      scheduler,
      client,
      1n,
      2n,
    );

    state =
      await factory.read.getMarket([1n]);

    assert.equal(
      state.attempts,
      3,
    );

    assert.equal(
      state.state,
      4,
    );
  });

  it("exposes the expected protocol constants", async function () {
    const { factory } = await deploy();

    assert.equal(
      await factory.read.MAX_ATTEMPTS(),
      3,
    );

    assert.equal(
      await factory.read.RETRY_INTERVAL_BLOCKS(),
      200,
    );

    assert.equal(
      await factory.read.RESOLVE_GAS_LIMIT(),
      2_000_000,
    );

    assert.equal(
      await factory.read.SCHEDULER_TTL_BLOCKS(),
      150,
    );

    assert.equal(
      await factory.read.HTTP_TTL_BLOCKS(),
      100n,
    );

    assert.equal(
      await factory.read.EXECUTOR_PROBES(),
      8n,
    );
  });
  it("resolves successfully through mocked HTTP and jq", async function () {
    const {
      factory,
      viem,
      alice,
      bob,
    } = await deploy();

    const client =
      await viem.getPublicClient();

    await installOracleMocks(
      viem,
      client,
    );

    await factory.write.createMarket([
      market,
    ]);

    await factory.write.bet(
      [1n, true],
      {
        account: alice.account,
        value: 1_000_000_000_000_000_000n,
      },
    );

    await factory.write.bet(
      [1n, false],
      {
        account: bob.account,
        value: 2_000_000_000_000_000_000n,
      },
    );

    const scheduler =
      await viem.getContractAt(
        "MockScheduler",
        SCHEDULER,
      );

    const created =
      await factory.read.getMarket([1n]);

    const currentBlock =
      await client.getBlockNumber();

    await mineBlocks(
      client,
      created.closeBlock -
        currentBlock +
        1n,
    );

    await execute(
      scheduler,
      client,
      1n,
      0n,
    );

    const resolved =
      await factory.read.getMarket([1n]);

    assert.equal(
      resolved.state,
      3,
    );

    assert.equal(
      resolved.outcome,
      1,
    );

    assert.equal(
      resolved.observedValue,
      3500n,
    );

    assert.equal(
      resolved.attempts,
      1,
    );

    const aliceStake =
      await factory.read.stakesOf([
        1n,
        alice.account.address,
      ]);

    assert.equal(
      aliceStake[3],
      3_000_000_000_000_000_000n,
    );

    const bobStake =
      await factory.read.stakesOf([
        1n,
        bob.account.address,
      ]);

    assert.equal(
      bobStake[3],
      0n,
    );
  });

  it("allows the winning YES bettor to claim the full pari-mutuel pool", async function () {
    const {
      factory,
      viem,
      alice,
      bob,
    } = await deploy();

    const client =
      await viem.getPublicClient();

    await installOracleMocks(
      viem,
      client,
    );

    await factory.write.createMarket([
      market,
    ]);

    await factory.write.bet(
      [1n, true],
      {
        account: alice.account,
        value: 1_000_000_000_000_000_000n,
      },
    );

    await factory.write.bet(
      [1n, false],
      {
        account: bob.account,
        value: 2_000_000_000_000_000_000n,
      },
    );

    const scheduler =
      await viem.getContractAt(
        "MockScheduler",
        SCHEDULER,
      );

    const created =
      await factory.read.getMarket([1n]);

    const currentBlock =
      await client.getBlockNumber();

    await mineBlocks(
      client,
      created.closeBlock -
        currentBlock +
        1n,
    );

    await execute(
      scheduler,
      client,
      1n,
      0n,
    );

    const before =
      await factory.read.stakesOf([
        1n,
        alice.account.address,
      ]);

    assert.equal(
      before[3],
      3_000_000_000_000_000_000n,
    );

    await factory.write.claimWinnings(
      [1n],
      {
        account: alice.account,
      },
    );

    const after =
      await factory.read.stakesOf([
        1n,
        alice.account.address,
      ]);

    assert.equal(
      after[2],
      true,
    );

    assert.equal(
      after[3],
      0n,
    );

    await assert.rejects(
      factory.write.claimWinnings(
        [1n],
        {
          account: alice.account,
        },
      ),
    );
  });

  it("allows the winning NO bettor to claim the full pari-mutuel pool", async function () {
    const {
      factory,
      viem,
      alice,
      bob,
    } = await deploy();

    const client =
      await viem.getPublicClient();

    await installOracleMocks(
      viem,
      client,
    );

    // MockJQ returns 3500, so use a 4000 target:
    // 3500 < 4000 => NO wins.
    await factory.write.createMarket([
      {
        ...market,
        target: 4000n,
        comparator: 2, // LT
      },
    ]);
    const createdDebug = await factory.read.getMarket([1n]);
    console.log("NO TEST MARKET STORED:", {
      target: createdDebug.target,
      comparator: createdDebug.comparator,
      closeBlock: createdDebug.closeBlock,
      resolveBlock: createdDebug.resolveBlock,
      scheduleId: createdDebug.scheduleId,
    });
    assert.equal(createdDebug.target, 4000n, "target must be 4000");
    assert.equal(createdDebug.comparator, 2, "comparator must be LT (2)");

    await factory.write.bet(
      [1n, true],
      {
        account: alice.account,
        value: 1_000_000_000_000_000_000n,
      },
    );

    await factory.write.bet(
      [1n, false],
      {
        account: bob.account,
        value: 2_000_000_000_000_000_000n,
      },
    );

    const scheduler =
      await viem.getContractAt(
        "MockScheduler",
        SCHEDULER,
      );

    const created =
      await factory.read.getMarket([1n]);

    const currentBlock =
      await client.getBlockNumber();

    await mineBlocks(
      client,
      created.closeBlock -
        currentBlock +
        1n,
    );

    await execute(
      scheduler,
      client,
      1n,
      0n,
    );

    const resolved =
      await factory.read.getMarket([1n]);

    assert.equal(
      resolved.state,
      3,
      "market should be resolved",
    );

    assert.equal(
      resolved.outcome,
      2,
      "NO should win",
    );

    assert.equal(
      resolved.observedValue,
      3500n,
      "oracle value should be 3500",
    );

    const aliceStake =
      await factory.read.stakesOf([
        1n,
        alice.account.address,
      ]);

    const bobStake =
      await factory.read.stakesOf([
        1n,
        bob.account.address,
      ]);

    // 1 ETH YES + 2 ETH NO = 3 ETH pool.
    assert.equal(
      aliceStake[3],
      0n,
      "YES bettor must have no claimable payout",
    );

    assert.equal(
      bobStake[3],
      3_000_000_000_000_000_000n,
      "NO bettor should be able to claim the full 3 ETH pool",
    );

    await factory.write.claimWinnings(
      [1n],
      {
        account: bob.account,
      },
    );

    const bobAfter =
      await factory.read.stakesOf([
        1n,
        bob.account.address,
      ]);

    assert.equal(
      bobAfter[2],
      true,
      "NO bettor should be marked settled",
    );

    assert.equal(
      bobAfter[3],
      0n,
      "NO bettor should have nothing left to claim",
    );

    await assert.rejects(
      factory.write.claimWinnings(
        [1n],
        {
          account: bob.account,
        },
      ),
    );
  });

  it("makes a market invalid and refunds stakes when there are no winners", async function () {
    const {
      factory,
      viem,
      bob,
    } = await deploy();

    const client =
      await viem.getPublicClient();

    await installOracleMocks(
      viem,
      client,
    );

    await factory.write.createMarket([
      market,
    ]);

    await factory.write.bet(
      [1n, false],
      {
        account: bob.account,
        value: 2_000_000_000_000_000_000n,
      },
    );

    const scheduler =
      await viem.getContractAt(
        "MockScheduler",
        SCHEDULER,
      );

    const created =
      await factory.read.getMarket([1n]);

    const currentBlock =
      await client.getBlockNumber();

    await mineBlocks(
      client,
      created.closeBlock -
        currentBlock +
        1n,
    );

    await execute(
      scheduler,
      client,
      1n,
      0n,
    );

    const invalid =
      await factory.read.getMarket([1n]);

    assert.equal(
      invalid.state,
      4,
    );

    assert.equal(
      invalid.outcome,
      1,
    );

    assert.equal(
      invalid.invalidReason,
      "no YES winners",
    );

    const before =
      await factory.read.stakesOf([
        1n,
        bob.account.address,
      ]);

    assert.equal(
      before[3],
      2_000_000_000_000_000_000n,
    );

    await factory.write.claimRefund(
      [1n],
      {
        account: bob.account,
      },
    );

    const after =
      await factory.read.stakesOf([
        1n,
        bob.account.address,
      ]);

    assert.equal(
      after[2],
      true,
    );

    assert.equal(
      after[3],
      0n,
    );
  });

  it("cancels the remaining Scheduler retries after successful resolution", async function () {
    const {
      factory,
      viem,
      alice,
    } = await deploy();

    const client =
      await viem.getPublicClient();

    await installOracleMocks(
      viem,
      client,
    );

    await factory.write.createMarket([
      market,
    ]);

    await factory.write.bet(
      [1n, true],
      {
        account: alice.account,
        value: 1_000_000_000_000_000_000n,
      },
    );

    const scheduler =
      await viem.getContractAt(
        "MockScheduler",
        SCHEDULER,
      );

    const created =
      await factory.read.getMarket([1n]);

    const currentBlock =
      await client.getBlockNumber();

    await mineBlocks(
      client,
      created.closeBlock -
        currentBlock +
        1n,
    );

    await execute(
      scheduler,
      client,
      1n,
      0n,
    );

    const call =
      await scheduler.read.getCall([1n]);

    assert.equal(
      call[10],
      true,
    );
  });


});
