pragma solidity ^0.8.28;

contract MockJQ {
    uint256 public value = 3500;
    bool public shouldRevert;
    bool public emptyResult;

    function setSuccess(uint256 value_) external {
        value = value_;
        shouldRevert = false;
        emptyResult = false;
    }

    function setRevert() external {
        shouldRevert = true;
        emptyResult = false;
    }

    function setEmpty() external {
        shouldRevert = false;
        emptyResult = true;
    }

    fallback() external {
        if (shouldRevert) revert("mock jq revert");
        if (emptyResult) return;

        bytes memory out = abi.encode(value);

        assembly {
            return(add(out, 32), mload(out))
        }
    }
}
