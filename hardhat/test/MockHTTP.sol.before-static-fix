pragma solidity ^0.8.28;

contract MockHTTP {
    uint16 public status = 200;
    bytes public body = hex"7b227072696365223a333530307d";
    string public errorMessage;
    bool public shouldRevert;
    bool public malformed;

    function setSuccess(uint16 status_, bytes calldata body_) external {
        status = status_;
        body = body_;
        errorMessage = "";
        shouldRevert = false;
        malformed = false;
    }

    function setError(string calldata reason) external {
        errorMessage = reason;
        shouldRevert = false;
        malformed = false;
    }

    function setRevert() external {
        shouldRevert = true;
        malformed = false;
    }

    function setMalformed() external {
        shouldRevert = false;
        malformed = true;
    }

    function fallbackResponse() external view returns (bytes memory) {
        if (shouldRevert) revert("mock HTTP revert");
        if (malformed) return hex"1234";

        bytes memory actual = abi.encode(
            status,
            new string[](0),
            new string[](0),
            body,
            errorMessage
        );

        return abi.encode(bytes(""), actual);
    }

    fallback() external {
        bytes memory out = this.fallbackResponse();

        assembly {
            return(add(out, 32), mload(out))
        }
    }
}
