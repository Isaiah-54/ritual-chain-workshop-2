pragma solidity ^0.8.28;

contract MockTEERegistry {
    address public executor = address(1);
    bool public available = true;

    function setExecutor(
        address executor_,
        bool available_
    ) external {
        executor = executor_;
        available = available_;
    }

    function pickServiceByCapability(
        uint8,
        bool,
        uint256,
        uint256
    )
        external
        view
        returns (address teeAddress, bool found)
    {
        return (executor, available);
    }
}
