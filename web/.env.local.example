# Copy this file to .env.local and fill in your deployed contract's details.

# Your deployed RitualPredict contract address
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourContractAddressHere

# An RPC endpoint for Ritual Chain (the one your hardhat.config uses)
NEXT_PUBLIC_RPC_URL=https://your-ritual-rpc-url

# Chain ID in hex, e.g. 0x1234 — used for wallet_switchEthereumChain / wallet_addEthereumChain.
# Leave blank to skip automatic network switching.
NEXT_PUBLIC_CHAIN_ID_HEX=

# Display name shown when prompting a wallet to add the network
NEXT_PUBLIC_CHAIN_NAME=Ritual Chain

# Optional — used as the blockExplorerUrl when adding the network to a wallet
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://explorer.ritualfoundation.org

